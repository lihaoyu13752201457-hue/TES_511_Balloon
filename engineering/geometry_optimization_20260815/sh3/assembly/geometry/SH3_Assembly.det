// DEMO2_DR_v3p5_minpatch_centerfinger_megalib_proxy detector map
// TES core follows the legacy DEMO2 6-layer MDCalorimeter pixel map; native veto timing is handled downstream.

MDCalorimeter D1
D1.SensitiveVolume TES_Pixel_L0
D1.DetectorVolume TES_L0
D1.StructuralPitch 0.155 0.155 0.1
D1.StructuralOffset 0 0 0
D1.TriggerThreshold 0.3 0.0
D1.EnergyResolution Gauss 0.3 0.3 0.14
D1.EnergyResolution Gauss 3000 3000 0.14


MDCalorimeter D2
D2.SensitiveVolume TES_Pixel_L1
D2.DetectorVolume TES_L1
D2.StructuralPitch 0.155 0.155 0.1
D2.StructuralOffset 0 0 0
D2.TriggerThreshold 0.3 0.0
D2.EnergyResolution Gauss 0.3 0.3 0.14
D2.EnergyResolution Gauss 3000 3000 0.14


MDCalorimeter D3
D3.SensitiveVolume TES_Pixel_L2
D3.DetectorVolume TES_L2
D3.StructuralPitch 0.155 0.155 0.1
D3.StructuralOffset 0 0 0
D3.TriggerThreshold 0.3 0.0
D3.EnergyResolution Gauss 0.3 0.3 0.14
D3.EnergyResolution Gauss 3000 3000 0.14


MDCalorimeter D4
D4.SensitiveVolume TES_Pixel_L3
D4.DetectorVolume TES_L3
D4.StructuralPitch 0.155 0.155 0.1
D4.StructuralOffset 0 0 0
D4.TriggerThreshold 0.3 0.0
D4.EnergyResolution Gauss 0.3 0.3 0.14
D4.EnergyResolution Gauss 3000 3000 0.14


MDCalorimeter D5
D5.SensitiveVolume TES_Pixel_L4
D5.DetectorVolume TES_L4
D5.StructuralPitch 0.155 0.155 0.1
D5.StructuralOffset 0 0 0
D5.TriggerThreshold 0.3 0.0
D5.EnergyResolution Gauss 0.3 0.3 0.14
D5.EnergyResolution Gauss 3000 3000 0.14


MDCalorimeter D6
D6.SensitiveVolume TES_Pixel_L5
D6.DetectorVolume TES_L5
D6.StructuralPitch 0.155 0.155 0.1
D6.StructuralOffset 0 0 0
D6.TriggerThreshold 0.3 0.0
D6.EnergyResolution Gauss 0.3 0.3 0.14
D6.EnergyResolution Gauss 3000 3000 0.14

// BEGIN SH3_ACTIVE_BGO40_DET
// Native SG3B BGO scorer convention retained; timing/veto policy remains downstream.
Scintillator SH3_BGO40_SideShield_SD
SH3_BGO40_SideShield_SD.SensitiveVolume SH3_BGO40_SideShield
SH3_BGO40_SideShield_SD.DetectorVolume SH3_BGO40_SideShield
SH3_BGO40_SideShield_SD.TriggerThreshold 80
SH3_BGO40_SideShield_SD.NoiseThresholdEqualsTriggerThreshold true
SH3_BGO40_SideShield_SD.EnergyResolution Gauss 80 80 1
SH3_BGO40_SideShield_SD.EnergyResolution Gauss 3000 3000 1

Scintillator SH3_BGO40_FrontOpticalAnnulus_SD
SH3_BGO40_FrontOpticalAnnulus_SD.SensitiveVolume SH3_BGO40_FrontOpticalAnnulus
SH3_BGO40_FrontOpticalAnnulus_SD.DetectorVolume SH3_BGO40_FrontOpticalAnnulus
SH3_BGO40_FrontOpticalAnnulus_SD.TriggerThreshold 80
SH3_BGO40_FrontOpticalAnnulus_SD.NoiseThresholdEqualsTriggerThreshold true
SH3_BGO40_FrontOpticalAnnulus_SD.EnergyResolution Gauss 80 80 1
SH3_BGO40_FrontOpticalAnnulus_SD.EnergyResolution Gauss 3000 3000 1

Scintillator SH3_BGO40_RearColdPortAnnulus_SD
SH3_BGO40_RearColdPortAnnulus_SD.SensitiveVolume SH3_BGO40_RearColdPortAnnulus
SH3_BGO40_RearColdPortAnnulus_SD.DetectorVolume SH3_BGO40_RearColdPortAnnulus
SH3_BGO40_RearColdPortAnnulus_SD.TriggerThreshold 80
SH3_BGO40_RearColdPortAnnulus_SD.NoiseThresholdEqualsTriggerThreshold true
SH3_BGO40_RearColdPortAnnulus_SD.EnergyResolution Gauss 80 80 1
SH3_BGO40_RearColdPortAnnulus_SD.EnergyResolution Gauss 3000 3000 1

// END SH3_ACTIVE_BGO40_DET
