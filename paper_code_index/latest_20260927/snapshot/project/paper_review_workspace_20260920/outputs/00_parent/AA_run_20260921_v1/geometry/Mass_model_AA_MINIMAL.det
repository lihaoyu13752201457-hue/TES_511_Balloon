// Same physical AA geometry. Six TES layers and three BGO scorers only.

MDCalorimeter D1
D1.SensitiveVolume TES_Pixel_L0
D1.DetectorVolume TES_L0
D1.StructuralPitch 0.155 0.155 0.1
D1.StructuralOffset 0 0 0
D1.TriggerThreshold 0.3 0.0
D1.EnergyResolution Gauss 0.3 0.3 0.14
D1.EnergyResolution Gauss 3000 3000 0.14

MDCalorimeter D2
D2.SensitiveVolume TES_Pixel_L1
D2.DetectorVolume TES_L1
D2.StructuralPitch 0.155 0.155 0.1
D2.StructuralOffset 0 0 0
D2.TriggerThreshold 0.3 0.0
D2.EnergyResolution Gauss 0.3 0.3 0.14
D2.EnergyResolution Gauss 3000 3000 0.14

MDCalorimeter D3
D3.SensitiveVolume TES_Pixel_L2
D3.DetectorVolume TES_L2
D3.StructuralPitch 0.155 0.155 0.1
D3.StructuralOffset 0 0 0
D3.TriggerThreshold 0.3 0.0
D3.EnergyResolution Gauss 0.3 0.3 0.14
D3.EnergyResolution Gauss 3000 3000 0.14

MDCalorimeter D4
D4.SensitiveVolume TES_Pixel_L3
D4.DetectorVolume TES_L3
D4.StructuralPitch 0.155 0.155 0.1
D4.StructuralOffset 0 0 0
D4.TriggerThreshold 0.3 0.0
D4.EnergyResolution Gauss 0.3 0.3 0.14
D4.EnergyResolution Gauss 3000 3000 0.14

MDCalorimeter D5
D5.SensitiveVolume TES_Pixel_L4
D5.DetectorVolume TES_L4
D5.StructuralPitch 0.155 0.155 0.1
D5.StructuralOffset 0 0 0
D5.TriggerThreshold 0.3 0.0
D5.EnergyResolution Gauss 0.3 0.3 0.14
D5.EnergyResolution Gauss 3000 3000 0.14

MDCalorimeter D6
D6.SensitiveVolume TES_Pixel_L5
D6.DetectorVolume TES_L5
D6.StructuralPitch 0.155 0.155 0.1
D6.StructuralOffset 0 0 0
D6.TriggerThreshold 0.3 0.0
D6.EnergyResolution Gauss 0.3 0.3 0.14
D6.EnergyResolution Gauss 3000 3000 0.14

// BEGIN GEOOPT_S3C_DET
// Scorers for the variant replacement scintillator/wrapper/mechanical shell package.
Scintillator BGO_S3C_FullWrap_SideShell_WindowCut_40mm_SD
BGO_S3C_FullWrap_SideShell_WindowCut_40mm_SD.SensitiveVolume BGO_S3C_FullWrap_SideShell_WindowCut_40mm
BGO_S3C_FullWrap_SideShell_WindowCut_40mm_SD.DetectorVolume BGO_S3C_FullWrap_SideShell_WindowCut_40mm
BGO_S3C_FullWrap_SideShell_WindowCut_40mm_SD.TriggerThreshold 80
BGO_S3C_FullWrap_SideShell_WindowCut_40mm_SD.NoiseThresholdEqualsTriggerThreshold true
BGO_S3C_FullWrap_SideShell_WindowCut_40mm_SD.EnergyResolution Gauss 80 80 1
BGO_S3C_FullWrap_SideShell_WindowCut_40mm_SD.EnergyResolution Gauss 3000 3000 1

// BEGIN GEOOPT_S3D_O8_FALLBACK_MINPATCH_DET
// O8 BGO scorers retain the native C0 80 keV definition; the frozen analysis veto remains 50 keV.
Scintillator BGO_S3D_O8_FullWrap_BottomCap_30mm_SD
BGO_S3D_O8_FullWrap_BottomCap_30mm_SD.SensitiveVolume BGO_S3D_O8_FullWrap_BottomCap_30mm
BGO_S3D_O8_FullWrap_BottomCap_30mm_SD.DetectorVolume BGO_S3D_O8_FullWrap_BottomCap_30mm
BGO_S3D_O8_FullWrap_BottomCap_30mm_SD.TriggerThreshold 80
BGO_S3D_O8_FullWrap_BottomCap_30mm_SD.NoiseThresholdEqualsTriggerThreshold true
BGO_S3D_O8_FullWrap_BottomCap_30mm_SD.EnergyResolution Gauss 80 80 1
BGO_S3D_O8_FullWrap_BottomCap_30mm_SD.EnergyResolution Gauss 3000 3000 1

Scintillator AA_BGO_TopCap_12Ports_10mm_SD
AA_BGO_TopCap_12Ports_10mm_SD.SensitiveVolume AA_BGO_TopCap_12Ports_10mm
AA_BGO_TopCap_12Ports_10mm_SD.DetectorVolume AA_BGO_TopCap_12Ports_10mm
AA_BGO_TopCap_12Ports_10mm_SD.TriggerThreshold 80
AA_BGO_TopCap_12Ports_10mm_SD.NoiseThresholdEqualsTriggerThreshold true
AA_BGO_TopCap_12Ports_10mm_SD.EnergyResolution Gauss 80 80 1
AA_BGO_TopCap_12Ports_10mm_SD.EnergyResolution Gauss 3000 3000 1
