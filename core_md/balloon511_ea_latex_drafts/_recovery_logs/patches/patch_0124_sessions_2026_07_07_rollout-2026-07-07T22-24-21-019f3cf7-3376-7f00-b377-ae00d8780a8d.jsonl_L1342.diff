+def read_fragment(fragment_path: Path):
+    text = fragment_path.read_text(encoding="utf-8", errors="replace")
+    head, sep, body = text.partition("\n\n")
+    if not sep:
+        return {}, text
+    try:
+        meta = json.loads(head)
+    except json.JSONDecodeError:
+        meta = {}
+    return meta, body
