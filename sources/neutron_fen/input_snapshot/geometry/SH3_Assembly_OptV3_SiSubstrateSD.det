// Diagnostic-only Si substrate scorers, reused from the retained all-SD detector-map convention.
// These channels record Geant4 energy deposition in the six Si slabs. They are not TES channels,
// and no Si-to-TES phonon or thermal collection efficiency is applied at this transport stage.

Scintillator Si_Substrate_Stack_side_entry_L0_SD
Si_Substrate_Stack_side_entry_L0_SD.SensitiveVolume Si_Substrate_Stack_side_entry_L0
Si_Substrate_Stack_side_entry_L0_SD.DetectorVolume Si_Substrate_Stack_side_entry_L0
Si_Substrate_Stack_side_entry_L0_SD.TriggerThreshold 0.001
Si_Substrate_Stack_side_entry_L0_SD.EnergyResolution Gauss 0.001 0.001 1
Si_Substrate_Stack_side_entry_L0_SD.EnergyResolution Gauss 3000 3000 1

