{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tes511:m05-compact-smoke:independent-transport-authorization:v1",
  "title": "Independent write-once transport authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_path",
    "schema_sha256",
    "status",
    "transport_authorized",
    "benchmark_class",
    "authorization_id",
    "issued_utc",
    "reviewer",
    "execution_environment",
    "bindings",
    "constraints",
    "decision"
  ],
  "properties": {
    "schema_version": {
      "const": "m05-independent-transport-authorization-v1"
    },
    "schema_path": {
      "const": "engineering/particle_source_unit_repair_20260811/m05_complete_compact_smoke_20260812/schema/transport_authorization_v1.schema.json"
    },
    "schema_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "const": "PASS__SECOND_INDEPENDENT_REVIEW__TRANSPORT_AUTHORIZED"
    },
    "transport_authorized": {
      "const": true
    },
    "benchmark_class": {
      "const": "NON_MERGEABLE_BENCHMARK"
    },
    "authorization_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"
    },
    "issued_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "identity"],
      "properties": {
        "role": {
          "const": "second_independent_evaluator"
        },
        "identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "execution_environment": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_snapshot_sha256",
        "benchmark_contract_sha256",
        "preflight_validation_sha256",
        "planned_job_manifest_sha256",
        "job_sequence_sha256",
        "execution_environment_sha256"
      ],
      "properties": {
        "execution_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "benchmark_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "preflight_validation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "planned_job_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "job_sequence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "execution_environment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_concurrent_transport_processes",
        "maximum_new_smoke_bytes",
        "minimum_live_disk_reserve_bytes",
        "preserve_partial_outputs",
        "concatenate_transport_outputs",
        "seed_policy",
        "job_selection"
      ],
      "properties": {
        "max_concurrent_transport_processes": {"const": 1},
        "maximum_new_smoke_bytes": {"const": 10000000000},
        "minimum_live_disk_reserve_bytes": {"const": 21474836480},
        "preserve_partial_outputs": {"const": true},
        "concatenate_transport_outputs": {"const": false},
        "seed_policy": {"const": "exact_planned_manifest_only"},
        "job_selection": {"const": "all_jobs_in_frozen_manifest_order"}
      }
    },
    "decision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  }
}
