    "o8_bgo",
    "o8_plastic"
  ],
  "tes_physical_volume_regex": "^TP_L[0-5]_[0-9]+$",
  "kapton_diagnostic_rule": "case-insensitive physical-volume substring KAPTON; diagnostic only and never veto/candidate by itself",
  "mass_csi_physical_volumes": [
