  "selection_rule": "native truth iff raw TES energy is positive or the tape root is a pre-registered control; veto-only events retain typed block summaries but do not select native truth; Kapton alone is excluded",
  "passive_exclusions": [
    "kapton",
    "bpe",
    "tungsten",
    "aluminum"
  ]
