        "completed_flag",
        "aborted_flag",
        "raw_tape_line_sha256",
        "expected_generated_tuple_sha256",
        "observed_generated_tuple_sha256",
        "observed_ia_init_tuple_sha256",
        "control_flag"
      ],
      "columns": {
        "simulation_event_id": {"type": "positive_int"},
        "row_index0": {"type": "nonnegative_int"},
        "eventlist_id": {"type": "positive_int"},
        "stable_root_id": {"type": "sha256"},
        "benchmark_driver_id": {"type": "nonempty_text"},
        "driver_inference": {"type": "optional_text"},
