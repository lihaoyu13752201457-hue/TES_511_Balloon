        "driver_inference_ambiguity_set": {"type": "canonical_string_array"},
        "family": {"type": "enum", "values": ["gamma", "n", "eminus", "eplus", "alpha", "muplus", "muminus"]},
        "generated_flag": {"type": "bool01"},
        "started_flag": {"type": "bool01"},
        "native_event_populated": {"type": "bool01"},
        "completed_flag": {"type": "bool01"},
        "aborted_flag": {"type": "bool01"},
