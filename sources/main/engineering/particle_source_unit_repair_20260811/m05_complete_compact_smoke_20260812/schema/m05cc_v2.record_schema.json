{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tes511:m05cc-v2-record-bundle",
  "title": "M05 compact v2 physical TSV bundle manifest and executable record contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_schema_sha256",
    "veto_whitelist_sha256",
    "geometry_classification_sha256",
    "provenance",
    "run",
    "tables",
    "blobs"
  ],
  "properties": {
    "schema_version": {"const": "m05cc-v2-record-bundle"},
    "record_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "veto_whitelist_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "geometry_classification_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geometry_bundle_sha256",
        "tape_root_sidecar_sha256",
        "tape_root_sidecar_path",
        "source_card_sha256",
        "source_contract_sha256"
      ],
      "properties": {
        "geometry_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "tape_root_sidecar_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "tape_root_sidecar_path": {"type": "string", "minLength": 1},
        "source_card_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arm",
        "geometry",
        "mode",
        "family",
        "job_id",
        "shard_index",
        "seed",
        "active_block_coverage",
        "expected_event_count"
      ],
      "properties": {
        "arm": {"const": "C"},
        "geometry": {"enum": ["mass_model_511", "s3d_o8"]},
        "mode": {"enum": ["instant", "buildup"]},
        "family": {"enum": ["gamma", "n", "eminus", "eplus", "alpha", "muplus", "muminus"]},
        "job_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "shard_index": {"type": "integer", "minimum": 0},
        "seed": {"type": "integer", "minimum": 1, "maximum": 2147483646},
        "active_block_coverage": {"const": "geometry_specific"},
        "expected_event_count": {"type": "integer", "minimum": 1}
      }
    },
    "tables": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roots",
        "generated_observations",
        "events",
        "pixels",
        "deposits",
        "veto_blocks",
        "activation",
        "truth_index",
        "footer"
      ],
      "properties": {
        "roots": {"$ref": "#/$defs/table_binding"},
        "generated_observations": {"$ref": "#/$defs/table_binding"},
        "events": {"$ref": "#/$defs/table_binding"},
        "pixels": {"$ref": "#/$defs/table_binding"},
        "deposits": {"$ref": "#/$defs/table_binding"},
        "veto_blocks": {"$ref": "#/$defs/table_binding"},
        "activation": {"$ref": "#/$defs/table_binding"},
        "truth_index": {"$ref": "#/$defs/table_binding"},
        "footer": {"$ref": "#/$defs/table_binding"}
      }
    },
    "blobs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["truth_stream", "native_dat"],
      "properties": {
        "truth_stream": {"$ref": "#/$defs/blob_binding"},
        "native_dat": {"$ref": "#/$defs/blob_binding"}
      }
    }
  },
  "$defs": {
    "table_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "row_count"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "row_count": {"type": "integer", "minimum": 0}
      }
    },
    "blob_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    }
  },
  "x-record-contract": {
    "schema_version": "m05cc-v2-record-schema",
    "encoding": "UTF-8",
    "delimiter": "TAB",
    "newline": "LF",
    "header_policy": "exact_order_no_missing_no_extra",
    "additional_properties_equivalent": "Every TSV header must exactly equal its declared header and every manifest object has additionalProperties=false.",
    "float_policy": "Canonical finite decimal/scientific syntax only; NaN and infinities are forbidden.",
    "float_comparison": {"absolute_tolerance": 1e-6, "relative_tolerance": 1e-9},
    "time_semantics": {
      "version": "POST_GLOBAL_V1",
      "definition": "All pixel and active-block min/max/energy-weighted aggregate times are recomputed exclusively from deposit post_time_s, matching native CC HIT POST global time. pre_time_s remains separate step truth and is never mixed into these aggregates."
    },
    "generated_observation_time": "native_event_time_s must be finite/nonnegative and numerically identical to observed_generated_source_time_s; serialized_ia_time_s is the literal zero native IA INIT record time.",
    "ia_init_digest": {
      "version": "m05-ia-init-state-v1",
      "algorithm": "SHA256(domain including NUL || canonical compact JSON integer array || LF)",
      "domain_bytes": "m05-ia-init-state-v1\\0",
      "array": "[particle,q(time_s*1e12),q(x/y/z_cm*1e6),q(unit_dx/dy/dz*1e9),q(px/py/pz*1e9),q(energy_keV*1e6)]",
      "rounding": "C++ std::llround, half away from zero",
      "excludes": "Excitation is not present in serialized IA INIT and is not hashed; serialized_ia_time_s is the actual native IA record time (required zero)."
    },
    "active_block_completeness": {
      "geometry_specific": {"mass_model_511": 24, "s3d_o8": 6},
      "detector_uid": "<detector_type>:<physical_volume>, exactly as frozen by the hash-bound whitelist",
      "cross_geometry_rows": "Forbidden: Mass emits only 24 CsI rows; S3d-O8 emits only 3 BGO plus 3 plastic rows."
    },
    "veto_decisions": {
      "mass_model_511": "pass_vetoT iff mass_csi_keV < T",
      "s3d_o8": "pass_vetoT iff o8_bgo_keV < T AND o8_plastic_keV < 50 keV; active_veto_total_keV is diagnostic only",
      "thresholds_keV": [50, 70, 80],
      "boundary": "All comparisons are strict less-than. O8 plastic equality at 50 keV vetoes for every threshold."
    },
    "truth_selection": "Exactly one truth_index row is required iff raw_tes_positive=1 or control_flag=1; veto-only events retain the complete block summary without forced duplicate IA/HT truth."
  },
  "x-tsv-tables": {
