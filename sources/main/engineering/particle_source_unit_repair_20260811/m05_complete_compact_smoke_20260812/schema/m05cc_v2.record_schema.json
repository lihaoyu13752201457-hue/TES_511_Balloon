        "observed_generated_tuple_sha256": {"type": "sha256"},
        "observed_ia_init_tuple_sha256": {"type": "sha256"},
        "control_flag": {"type": "bool01"}
      },
      "primary_key": ["simulation_event_id"],
      "unique_keys": [["row_index0"], ["eventlist_id"], ["stable_root_id"]]
    },
